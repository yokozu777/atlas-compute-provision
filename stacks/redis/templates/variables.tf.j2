  default   = "{{ provision_proxmox_token_secret }}"
}

variable "provision_proxmox_tls_insecure" {
  type    = bool
  default = {{ provision_proxmox_tls_insecure | lower }}
}

variable "provision_proxmox_parallel" {
  type    = number
  default = {{ provision_proxmox_parallel }}
}

variable "provision_dns_server" {
