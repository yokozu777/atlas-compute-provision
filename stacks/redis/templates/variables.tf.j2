# Generated by role 08_generate_tf_vars — stack redis
# Source of truth: {{ provision_hosts_file }}

{% for inventory_group, tf_variable in provision_inventory_group_map.items() %}
variable "{{ tf_variable }}" {
  description = "{{ tf_variable }} VMs configurations"
  default = {
{% for ip, host in provision_inventory_groups_index[inventory_group].hosts.items() %}
{# PVE VM name = full inventory hostname (FQDN). Quote key for HCL. #}
    "{{ host.hostname }}" = {
      vmid    = "{{ host.provision.vmid }}"
      sockets = {{ host.provision.sockets }}
      cores   = {{ host.provision.cores }}
      memory  = {{ host.provision.memory }}
      ip      = "ip={{ ip }}/{{ provision_network_prefix }},gw={{ provision_gateway }}"
      numa    = {{ host.provision.numa | lower }}
      clone   = "{{ host.provision.clone }}"  # PVE template name = provision_pve_templates key
      cluster_id      = "{{ cluster_id | default(cluster_workspace_id, true) }}"
      inventory_group = "{{ inventory_group }}"
      inventory_ip    = "{{ ip }}"
      disks = [
{% for disk in host.provision.disks %}
        {
          size    = "{{ disk.size }}"
          slot    = {{ disk.slot }}
          storage = "{{ disk.storage }}"
{% if disk.wwn is defined %}
          wwn     = "{{ disk.wwn }}"
{% endif %}
{% if disk.serial is defined %}
          serial  = "{{ disk.serial }}"
{% endif %}
        }{{ "," if not loop.last else "" }}
{% endfor %}
      ]
    }{{ "," if not loop.last else "" }}
{% endfor %}
  }
}

{% endfor %}
variable "provision_proxmox_api_url" {
  type    = string
  default = "{{ provision_proxmox_api_url }}"
}

variable "provision_proxmox_target_node" {
  type    = string
